APP_NAME="SEDEDE API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Origen(es) del frontend permitidos por CORS (lista separada por comas).
# En producción: https://www.tudominio.com
FRONTEND_URL=http://localhost:3000

# Minutos de validez del token de Sanctum (7 días = 10080).
SANCTUM_EXPIRATION=10080

# Dominios con autenticación por cookie (stateful). Se deja VACÍO a propósito:
# el panel usa tokens Bearer, no cookies. Poner aquí el dominio del frontend
# obligaría a usar sesiones y cookies con CORS con credenciales.
SANCTUM_STATEFUL_DOMAINS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

DB_PERSISTENT=false

# ---------------------------------------------------------------------------
# Cloudinary (imágenes de noticias y archivos de comunicados)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===========================================================================
# PRODUCCIÓN — valores que cambian al desplegar (ver DEPLOY.md)
# ===========================================================================
#
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://api.tudominio.com
# FRONTEND_URL=https://www.tudominio.com
# SANCTUM_STATEFUL_DOMAINS=
#
# Base de datos (Supabase Postgres). Las tablas noticias, comunicados, eventos
# y users YA EXISTEN en Supabase: no hay que ejecutar migraciones.
# DB_CONNECTION=pgsql
# DB_HOST=db.xxxxx.supabase.co
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres
# DB_PASSWORD=clave-de-supabase
#
# La tabla `sessions` no existe en Supabase: el API es sin estado (token Bearer),
# por eso el caché y las sesiones van a disco.
# SESSION_DRIVER=file
# CACHE_STORE=file
# QUEUE_CONNECTION=sync
#
# En contenedores los logs van a la salida estándar para verlos en el hosting.
# LOG_CHANNEL=stderr
#
# DB_PERSISTENT=true solo aporta con PHP-FPM/Apache (no con `artisan serve`).
# DB_PERSISTENT=true
